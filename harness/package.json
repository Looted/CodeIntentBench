{
  "name": "codeintentbench-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Runs CodeIntentBench tasks against coding agents under different rule-delivery arms and grades the results.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "cib": "./src/cli.ts"
  },
  "scripts": {
    "cib": "node src/cli.ts",
    "check": "node --check src/cli.ts && node src/cli.ts validate",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
