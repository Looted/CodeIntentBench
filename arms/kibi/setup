#!/usr/bin/env bash
# Arm `kibi`: the rules are recorded in a Kibi knowledge base and reach the agent
# through the kibi-claude plugin (hooks, skills, MCP server), installed as Kibi's
# documentation tells users: project-local kibi-cli / kibi-mcp / kibi-core on the
# PATH, `kibi init`, then the knowledge recorded through Kibi operations.
# Arguments: <workspace> <rulesDir> <runDir>
set -euo pipefail
ws="$1"; rules="$2"; run="$3"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
versions="$(cat "$here/versions.env")"; eval "$versions"

# Project-local Kibi, one directory above the workspace (the plugin's MCP launcher
# finds kibi-mcp by walking up from the workspace), so the project's own
# package.json and lockfile stay untouched.
mkdir -p "$run/kibi"
( cd "$run/kibi" && npm install --silent --no-audit --no-fund "kibi-cli@$KIBI_CLI" "kibi-mcp@$KIBI_MCP" "kibi-core@$KIBI_CORE" "kibi-runtime@$KIBI_RUNTIME" )
# kibi-mcp loads its operations from kibi-runtime and declares it with a caret range, so without the
# pin above a fresh install picks up whatever runtime npm has newest (a later release's operations
# over the pinned kibi-core). Refuse a tree where any of the four resolves to more than one version.
( cd "$run/kibi" && node -e '
  const { execFileSync } = require("node:child_process");
  const tree = JSON.parse(execFileSync("npm", ["ls", "--all", "--json"], { encoding: "utf8" }));
  const want = { "kibi-cli": process.argv[1], "kibi-mcp": process.argv[2], "kibi-core": process.argv[3], "kibi-runtime": process.argv[4] };
  const seen = {};
  const walk = (deps) => { for (const [name, d] of Object.entries(deps ?? {})) { if (name in want) (seen[name] ??= new Set()).add(d.version); walk(d.dependencies); } };
  walk(tree.dependencies);
  const bad = Object.entries(want).filter(([n, v]) => !seen[n] || seen[n].size !== 1 || !seen[n].has(v));
  if (bad.length) { console.error("kibi arm: unpinned Kibi packages: " + bad.map(([n, v]) => `${n} wanted ${v} got ${[...(seen[n] ?? ["none"])].join("+")}`).join(", ")); process.exit(1); }
' "$KIBI_CLI" "$KIBI_MCP" "$KIBI_CORE" "$KIBI_RUNTIME" )
export PATH="$run/kibi/node_modules/.bin:$PATH"

# The plugin at a pinned commit of the Kibi repository.
if [ ! -d "$run/plugin/kibi-claude" ]; then
  mkdir -p "$run/plugin"
  cache="${CIB_CACHE_DIR:-$here/../../cache}/kibi-repo"
  if [ ! -d "$cache/.git" ]; then git clone --quiet --filter=blob:none https://github.com/Looted/kibi "$cache"; fi
  git -C "$cache" fetch --quiet origin "$KIBI_REPO_COMMIT" 2>/dev/null || git -C "$cache" fetch --quiet origin
  rm -rf "$run/plugin/kibi-claude"
  git -C "$cache" archive "$KIBI_REPO_COMMIT" packages/claude | tar -x -C "$run/plugin"
  mv "$run/plugin/packages/claude" "$run/plugin/kibi-claude" && rmdir "$run/plugin/packages"
fi

cd "$ws"
kibi --version > "$run/kibi-version.txt"
kibi init
node "$here/../../harness/src/arm-tools/kibi-import.ts" "$ws" "$rules" "$run"
