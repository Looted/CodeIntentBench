#!/usr/bin/env bash
# Arm `docs`: decisions live in a docs/decisions folder inside the repository, one
# Markdown file per decision, the way maintainers leave ADRs. Nothing reads the
# folder for the agent; the convention in CLAUDE.md is the only pointer.
# Arguments: <workspace> <rulesDir> <runDir>
set -euo pipefail
ws="$1"; rules="$2"
mkdir -p "$ws/docs/decisions"
cat > "$ws/docs/decisions/README.md" <<'MD'
# Decisions

One file per product decision, named `NNNN-short-title.md`, with sections
**Decision**, **Why** and **Where** (the code paths or functions it applies to).

A file may open with the decision's standing: its **Status** (a decision marked
"not current" was closed or replaced and no longer holds), its **Firmness** (firm: a
person set it; follow it, and ask before changing it. default: a delegated or
agent choice; follow it, and supersede it only on evidence that it is wrong.
exploratory: a flagged guess; revisit it when you touch the area), when and by whom it was **Recorded**, and the decisions it
**Supersedes** or is **Superseded by**.
MD
# The project's rules (rule mode, or a knowledge base exported for an arc) are rendered as decision files.
if [ -n "$(ls -A "$rules" 2>/dev/null)" ]; then
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  node "$here/../../harness/src/arm-tools/render-docs.ts" "$ws" "$rules"
fi
